<Window x:Class="FileTogether.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileTogether.Client"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Title="File Together - Client" Height="800" Width="800">
    <Grid Margin="15">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="150"/>
    </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <TextBlock Text="Dark Mode" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ToggleButton x:Name="DarkThemeToggleButton" 
                          Click="DarkThemeToggleButton_Click"
                          materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="Gray"
                          Style="{StaticResource MaterialDesignSwitchToggleButton}" />
        </StackPanel>
        
    <materialDesign:Card Grid.Row="1" Padding="12" Margin="0,0,0,10" materialDesign:ElevationAssist.Elevation="Dp2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="SERVER" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0" 
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            <TextBox x:Name="TxtServerIP" Text="127.0.0.1" Grid.Column="1" Margin="5,0" 
                     materialDesign:HintAssist.Hint="IP Address"
                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                     materialDesign:TextFieldAssist.LeadingIcon="Server"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
            
            <TextBlock Text="PORT" VerticalAlignment="Center" Grid.Column="2" Margin="15,0,5,0" 
                       FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            <TextBox x:Name="TxtPort" Text="2121" Grid.Column="3" 
                     materialDesign:HintAssist.Hint="Port" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
            
            <TextBlock x:Name="TxtConnectionStatus" Text="● Disconnected" 
                       Foreground="Red" FontWeight="Bold" FontSize="11"
                       VerticalAlignment="Bottom" HorizontalAlignment="Right" Grid.Column="4" Margin="0,0,15,5"/>
            
            <Button x:Name="BtnLogout" Content="LOGOUT" Grid.Column="5" 
                    IsEnabled="False" Click="BtnLogout_Click" 
                    Background="Transparent" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" BorderBrush="Gray" BorderThickness="1"/>
        </Grid>
    </materialDesign:Card>
    
    <materialDesign:Card Grid.Row="2" Padding="12" Margin="0,0,0,10" >
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="AccountCircle" VerticalAlignment="Center" Foreground="Gray"/>
                    <TextBlock Text=" User:" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    <TextBlock x:Name="txtCurrentUser" Text="Not logged in" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    <TextBlock Text=" | Role:" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,5,0" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    <TextBlock x:Name="txtCurrentRole" Text="-" VerticalAlignment="Center" Foreground="DimGray"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Folder" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                    <TextBlock x:Name="txtCurrentPath" Text="/" Margin="10,0" VerticalAlignment="Center" 
                               FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="btnBack" Content="⬆ Back"  Margin="5,0" Click="BtnBack_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" BorderBrush="Gray"/>
                <Button x:Name="btnNewFolder" Content="📁 NEW FOLDER" Padding="10,0" Margin="5,0" Click="BtnNewFolder_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" BorderBrush="Gray"/>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
    
    <materialDesign:Card Grid.Row="3" materialDesign:ElevationAssist.Elevation="Dp1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <DataGrid x:Name="ItemDG" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserAddRows="False" GridLinesVisibility="None"
                      MouseDoubleClick="DgFiles_MouseDoubleClick" BorderThickness="0"
                      Background="{DynamicResource MaterialDesign.Brush.Surface}"
                      Style="{StaticResource MaterialDesignDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TYPE" Binding="{Binding TypeIcon}" Width="60"/>
                    <DataGridTextColumn Header="FILE NAME" Binding="{Binding FileName}" Width="*"/>
                    <DataGridTextColumn Header="SIZE" Binding="{Binding FormattedSize}" Width="100"/>
                    <DataGridTextColumn Header="DATE" Binding="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
                <Button x:Name="BtnRefresh" Content="REFRESH" Margin="5,0" Click="BtnRefresh_Click" 
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" BorderBrush="#DDDDDD"/>
    
                <Button x:Name="BtnDownload" Margin="5,0" Click="BtnDownload_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" Background="Black" Foreground="White">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Download" Margin="0,0,5,0"/>
                        <TextBlock Text="DOWNLOAD"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnUpload" Margin="5,0" Click="BtnUpload_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" Background="Black" Foreground="White">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Upload" Margin="0,0,5,0"/>
                        <TextBlock Text="UPLOAD"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnDelete" Content="DELETE" Click="BtnDelete_Click" 
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#E53935" BorderBrush="#E53935" Foreground="White"/>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
    
    <Grid Grid.Row="4" Margin="0,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ProgressBar x:Name="ProgressBar" Height="6" Value="45" Background="#E0E0E0" Foreground="Black" />
        <Grid Grid.Row="1" Margin="0,5,0,0">
            <TextBlock x:Name="TxtSpeed" Text="0 KB/s" FontSize="11" Foreground="Gray" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtProgress" Text="45%" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            <TextBlock x:Name="TxtETA" Text="00:00:00" FontSize="11" Foreground="Gray" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
    
    <materialDesign:Card Grid.Row="5" Background="#212121" UniformCornerRadius="5">
        <TextBox x:Name="TxtBoxLogs" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" 
                 Background="Transparent" Foreground="#81C784" BorderThickness="0" Padding="10"/>
    </materialDesign:Card>
        
</Grid>
</Window>
