<Window x:Class="FileTogether.Client.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:FileTogether.Client"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Title="RegisterWindow" Height="600" Width="800">
<Grid Margin="30">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    <RowDefinition Height="Auto"/> </Grid.RowDefinitions>
    
    <StackPanel Grid.Row="0" Margin="0,0,0,25">
        <materialDesign:PackIcon Kind="AccountPlus" 
                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}" 
                                 Width="48" Height="48" HorizontalAlignment="Center"/>
        <TextBlock Text="CREATE NEW ACCOUNT" 
                   FontSize="24" FontWeight="ExtraBold" 
                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" 
                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </StackPanel>
    
    <materialDesign:Card Grid.Row="1" Padding="20" materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="12">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtServerIP" Text="127.0.0.1"
                         materialDesign:HintAssist.Hint="Server IP"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Server"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                
                <TextBox x:Name="txtPort" Text="2121" Grid.Column="2"
                         materialDesign:HintAssist.Hint="Port"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
            </Grid>

            <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="0,0,0,20"/>

            <TextBox x:Name="txtUsername" Margin="0,0,0,15"
                     materialDesign:HintAssist.Hint="Username"
                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                     materialDesign:TextFieldAssist.LeadingIcon="Account"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     TextChanged="TxtUsername_TextChanged"/>
            
            <PasswordBox x:Name="txtPassword" Margin="0,0,0,15"
                         materialDesign:HintAssist.Hint="Password"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Lock"
                         
                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                         PasswordChanged="TxtPassword_PasswordChanged"/>
            
            <PasswordBox x:Name="txtConfirmPassword"
                         materialDesign:HintAssist.Hint="Confirm Password"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="LockCheck"
                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                         PasswordChanged="TxtConfirmPassword_PasswordChanged"
                         KeyDown="TxtConfirmPassword_KeyDown"/>
        </StackPanel>
    </materialDesign:Card>
    
    <StackPanel Grid.Row="2" Margin="0,20,0,0" VerticalAlignment="Top">
        <TextBlock x:Name="txtStatus" 
                   Foreground="{DynamicResource MaterialDesign.Brush.Error}" 
                   FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,15" Height="20"/>
        
        <materialDesign:Card Background="{DynamicResource MaterialDesign.Brush.Primary.Container}" 
                             Padding="12" UniformCornerRadius="8">
            <TextBlock TextAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary.OnContainer}" FontSize="12">
                <materialDesign:PackIcon Kind="InformationOutline" VerticalAlignment="Center"/>
                <Run Text=" Username: 3-20 characters | Password: Min 6 characters"/>
            </TextBlock>
        </materialDesign:Card>
    </StackPanel>
    
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
        <Button x:Name="btnRegister" Content="REGISTER NOW" Width="160" Height="45" 
                Style="{StaticResource MaterialDesignRaisedButton}"
                Margin="0,0,15,0" Click="BtnRegister_Click" IsDefault="True"/>
        
        <Button x:Name="btnCancel" Content="CANCEL" Width="120" Height="45" 
                Style="{StaticResource MaterialDesignOutlinedButton}"
                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                Click="BtnCancel_Click" IsCancel="True"/>
    </StackPanel>
</Grid>
</Window>
