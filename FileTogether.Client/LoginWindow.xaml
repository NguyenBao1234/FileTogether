<Window x:Class="FileTogether.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:FileTogether.Client"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Icon="E:\Applications and Programs\JetBrains Rider\Project\FileTogether\FileTogether.Client\FileTogether.ico"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Title="Login" Height="650" Width="800">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/> 
            <RowDefinition Height="Auto"/> 
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <materialDesign:PackIcon Kind="CloudSync" Foreground="Black" 
                                     Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="FILE TOGETHER" FontSize="28" FontWeight="ExtraBold" Foreground="Black"/>
        </StackPanel>

        <materialDesign:Card Grid.Row="2" Padding="20" materialDesign:ElevationAssist.Elevation="Dp4" UniformCornerRadius="10">
            <StackPanel>
                <TextBlock Text="Server Connection" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,15"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="txtServerIP" Text="127.0.0.1"
                             materialDesign:HintAssist.Hint="Server IP Address"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Server"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                    <TextBox x:Name="txtPort" Text="2121" Grid.Column="2"
                             materialDesign:HintAssist.Hint="Port"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                </Grid>

                <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="0,20"/>

                <TextBlock Text="Credentials" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,15"/>
                
                <TextBox x:Name="txtUsername" Text="admin" Margin="0,0,0,15"
                         materialDesign:HintAssist.Hint="Username"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Account"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                <PasswordBox x:Name="txtPassword"
                             materialDesign:HintAssist.Hint="Password"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Lock"
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                             KeyDown="TxtPassword_KeyDown"/>
            </StackPanel>
        </materialDesign:Card>

        <TextBlock x:Name="txtStatus" Grid.Row="3" 
                   Foreground="{DynamicResource MaterialDesign.Color.Error}" 
                   HorizontalAlignment="Center" Margin="0,15,0,0" Height="20"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
            
            <Button x:Name="btnLogin" Content="LOGIN" Width="130" Height="45" 
                    Style="{StaticResource MaterialDesignFlatMidBgButton}"
                    Margin="0,0,10,0" Click="BtnLogin_Click" IsDefault="True"/>
            
            <Button x:Name="btnRegister" Content="REGISTER" Width="130" Height="45" 
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="0,0,10,0" Click="BtnRegister_Click"/>
            
            <Button x:Name="btnCancel" Content="CANCEL" 
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>

        <TextBlock Grid.Row="5" TextAlignment="Center" FontSize="11" Margin="0,0,0,10" >
            <Run Text="Quick Login Tips:" FontWeight="Bold"/>
            <Run Text=" Admin (admin/admin123) • User (user/user123)"/>
        </TextBlock>
    </Grid>
</Window>
